{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taga3s-dev-blog-engine",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "preview_urls": false
}
