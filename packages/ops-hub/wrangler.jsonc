{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taga3s-dev-ops-hub",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
	"queues": {
		"consumers": [
			{
				"queue": "taga3s-dev-ops-hub",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
  "preview_urls": false
}
