{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taga3s-dev-ops-hub",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
	"secrets_store_secrets": [
		{
			"binding": "DISCORD_TOKEN",
			"store_id": "555db262e2a04edea88d0e38293f16ae",
			"secret_name": "DISCORD_TOKEN"
		},
		{
			"binding": "DISCORD_CHANNEL_ID",
			"store_id": "555db262e2a04edea88d0e38293f16ae",
			"secret_name": "DISCORD_CHANNEL_ID"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "taga3s-dev-ops-hub",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
  "preview_urls": false
}
