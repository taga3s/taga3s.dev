{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taga3s-dev-dispatcher",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
	"services": [
		{
			"binding": "BLOG_ENGINE_OGP",
			"service": "taga3s-dev-blog-engine",
			"entrypoint": "OGPEntrypoint"
		},
		{
			"binding": "BLOG_ENGINE_RSS",
			"service": "taga3s-dev-blog-engine",
			"entrypoint": "RSSEntrypoint"
		}
	],
	"secrets_store_secrets": [
		{
			"binding": "DISCORD_WEBHOOK_URL",
			"store_id": "555db262e2a04edea88d0e38293f16ae",
			"secret_name": "DISCORD_WEBHOOK_URL"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "taga3s-dev-dispatcher",
				"max_batch_size": 10,
				"max_batch_timeout": 5
			}
		]
	},
  "preview_urls": false
}
