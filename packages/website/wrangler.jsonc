{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taga3s-dev-website",
  "main": "./dist/index.mjs",
  "build": {
    "command": "pnpm build",
    "cwd": "./",
    "watch_dir": "./src"
  },
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "cache": {
    "enabled": true
  },
  "assets": {
    "directory": "public"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "r2_buckets": [
    {
      "binding": "TAGA3S_DEV_BUCKET",
      "bucket_name": "taga3s-dev"
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "TAGA3S_DEV_BUCKET",
        "bucket_name": "taga3s-dev"
      }
    ],
    "secrets_store_secrets": [
  		{
  			"binding": "CLOUDFLARE_ACCESS_AUD",
  			"store_id": "555db262e2a04edea88d0e38293f16ae",
  			"secret_name": "CLOUDFLARE_ACCESS_AUD"
  		}
	  ],
    "vars": {
      "TEAM_DOMAIN": "https://taga3s-dev.cloudflareaccess.com",
      "WORKERS_ENV": "preview"
    }
  },
  "preview_urls": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.ttf"],
      "fallthrough": true
    }
  ],
  "routes": [
    {
      "pattern": "taga3s.dev",
      "custom_domain": true
    }
  ],
}
